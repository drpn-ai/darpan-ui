# Template only. Vite does not load .env.example automatically.
# Local dev values belong in .env.
# UAT Firebase builds use .env.firebase via `npm run build:firebase`.
# Production Firebase builds should copy this file to .env.production.
VITE_DARPAN_API_BASE_URL=https://darpan.hotwax.io
VITE_DARPAN_RPC_URL=https://darpan.hotwax.io/rpc/json
# HttpOnly cookie auth (MACH P0 #6). false (default) = JS-readable sessionStorage bearer token.
# Set true in prod/UAT builds (.env.production / .env.firebase) so the session credential is the
# backend's HttpOnly darpan_login_key cookie instead. Requires the API's webapp_allow_origins to
# list this SPA origin with Access-Control-Allow-Credentials. NOTE: .env.production is gitignored,
# so the prod value must be set on the deploy source (deploy-host file or CI secret).
VITE_DARPAN_COOKIE_AUTH=false
# Optional customer-safe Linear pages for in-app roadmap and request access.
# VITE_DARPAN_LINEAR_ROADMAP_URL=https://linear.app/your-public-roadmap
# VITE_DARPAN_LINEAR_REQUEST_URL=https://linear.app/your-request-form
# Optional. Set false when the Linear target should open only in a new tab.
# VITE_DARPAN_LINEAR_EMBED_ENABLED=true
VITE_DARPAN_AUTH_BYPASS=false
