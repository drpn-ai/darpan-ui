{
  "name": "darpan-ui",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "Darpan frontend app (Vue + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "dev:stack": "./scripts/dev-stack.sh",
    "build": "npm run type-check && npm run build-only",
    "build-only": "vite build",
    "build:firebase": "vite build --mode firebase",
    "build:sm-darpan": "vite build --mode sm-darpan",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run lint:css && npm run type-check && npm run test",
    "sync-contract": "cp ../darpan-backend/runtime/component/darpan/docs/api-contract/methods.txt src/lib/api/contract/methods.txt && cp ../darpan-backend/runtime/component/darpan/docs/api-contract/openapi.json src/lib/api/contract/openapi.json && echo 'contract methods + openapi refreshed (rerun npm run generate-api-types)'",
    "generate-api-types": "openapi-typescript src/lib/api/contract/openapi.json -o src/lib/api/generated/schema.d.ts"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.5",
    "file-entry-cache@11": {
      "flat-cache": "6.1.23"
    }
  }
}
