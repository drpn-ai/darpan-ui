VITE_DARPAN_API_BASE_URL=https://sm-darpan-maarg.hotwax.io
VITE_DARPAN_RPC_URL=https://sm-darpan-maarg.hotwax.io/rpc/json
# Header (login_key) auth, matching the UAT posture: hotwax.io ingress rewrites
# Access-Control-Allow-Origin to '*', which browsers reject on credentialed requests.
# Flip to true once the ingress passes through per-origin ACAO with credentials.
VITE_DARPAN_COOKIE_AUTH=false
VITE_DARPAN_AUTH_BYPASS=false
