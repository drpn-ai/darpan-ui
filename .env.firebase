VITE_DARPAN_API_BASE_URL=https://api-uat.drpn.ai
VITE_DARPAN_RPC_URL=https://api-uat.drpn.ai/rpc/json
# MACH P0 #6 — HttpOnly cookie auth (UAT). Credential is the backend's HttpOnly darpan_login_key
# cookie, not a JS-readable bearer token. Requires the UAT API's webapp_allow_origins to list this
# SPA origin (app-uat.drpn.ai / the firebase host) with Access-Control-Allow-Credentials.
VITE_DARPAN_COOKIE_AUTH=true
VITE_DARPAN_AUTH_BYPASS=false
